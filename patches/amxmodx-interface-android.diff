+	 * copy. */
+	if (!lib || !lib->valid())
+	{
+		const char *base = file;
+		for (const char *p = file; *p; p++)
+		{
+			if (*p == '/')
+			{
+				base = p + 1;
+			}
+		}
+		if (base[0])
+		{
+			lib = ke::SharedLib::Open(base);
+		}
+	}
+#endif
 
