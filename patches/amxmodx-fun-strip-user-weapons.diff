+		const char *szClass = (*g_engfuncs.pfnSzFromIndex)(pEntity->v.classname);
+		if (!szClass
+			|| (strncmp(szClass, "weapon_", 7) != 0
+			&& strncmp(szClass, "ammo_", 5) != 0
+			&& strncmp(szClass, "item_", 5) != 0
+			&& strncmp(szClass, "tf_weapon_", 10) != 0))
+			continue;
+
+		REMOVE_ENTITY(pEntity);
 	}
 
