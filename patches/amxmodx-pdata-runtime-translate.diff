+static int TranslatePdataOffset(int iOffset, bool bCell)
+{
+	if (iOffset < 0 || iOffset > 0xFFFF)
+	{
+		return iOffset;
+	}
+
+	/* Array members are usually accessed as base + index; the index is
+	 * added before the fold, so each slot must be retargeted too. Pointer
+	 * arrays (classptr) are 8-byte strided on arm64 (was 4). */
+	if (bCell)
+	{
+		static const struct { unsigned short base32; unsigned short base64;
+		                       unsigned short stride64; unsigned short len; } s_PdataArrays[] =
+		{
+			{ 38, 52, 2, 5 },   // CWeaponBox::m_rgpPlayerItems[5]
+			{ 372, 412, 2, 5 }, // CBasePlayer::m_rgpPlayerItems[5]
+			{ 381, 430, 1, 32 },// CBasePlayer::m_rgAmmo[32]
+		};
+		unsigned int ai;
+		for (ai = 0; ai < sizeof(s_PdataArrays) / sizeof(s_PdataArrays[0]); ai++)
+		{
+			int d = iOffset - (int)s_PdataArrays[ai].base32;
+			if (d >= 0 && d < (int)s_PdataArrays[ai].len)
+			{
+				return (int)s_PdataArrays[ai].base64 + d * (int)s_PdataArrays[ai].stride64;
+			}
+		}
+	}
+
+
+	const struct PdataOffsetPair *t;
+	unsigned int n;
+
+	if (bCell)
+	{
+		t = s_TranslateCell;
+		n = sizeof(s_TranslateCell) / sizeof(s_TranslateCell[0]);
+	}
+	else
+	{
+		t = s_TranslateByte;
+		n = sizeof(s_TranslateByte) / sizeof(s_TranslateByte[0]);
+	}
+
+	const unsigned short key = (unsigned short)iOffset;
+	int lo = 0;
+	int hi = (int)n - 1;
+	while (lo <= hi)
+	{
+		int mid = (lo + hi) >> 1;
+		if (t[mid].b32 == key)
+		{
+			return t[mid].b64;
+		}
+		if (t[mid].b32 < key)
+		{
+			lo = mid + 1;
+		}
+		else
+		{
+			hi = mid - 1;
+		}
+	}
+
+	return iOffset;
+}
