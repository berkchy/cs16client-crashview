+
+// 64-bit: cvar_t* (64 bit) 32 bitlik cell'e sigmiyor. Eski kod pointer'i
+// cell'e kisaltip plugine veriyor, geri okurken de genisletiyordu; ARM64'te
+// bu vahsi pointer demek (tum get_pcvar_* copleri). Bunun yerine pluginlere
+// kucuk int handle verip cozumu tablodan yapiyoruz.
+static ke::Vector<cvar_t*> s_pcvarHandles;
+
+static cell PcvarToHandle(cvar_t* var)
+{
+	if (!var)
+		return 0;
+	if (s_pcvarHandles.empty())
+		s_pcvarHandles.append(nullptr); // index 0 stays invalid
+	for (size_t i = 1; i < s_pcvarHandles.length(); i++)
+	{
+		if (s_pcvarHandles[i] == var)
+			return (cell)i;
+	}
+	s_pcvarHandles.append(var);
+	return (cell)(s_pcvarHandles.length() - 1);
+}
+
+static cvar_t* HandleToPcvar(cell handle)
+{
+	if (handle <= 0 || (size_t)handle >= s_pcvarHandles.length())
+		return NULL;
+	return s_pcvarHandles[(size_t)handle];
+}
